{
  "name": "portfolio",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "dev:open": "ng serve --open",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "preview": "pnpm run build && pnpm dlx serve -s dist/portfolio/browser -l 4173",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "clean": "node -e \"for (const p of ['dist', '.angular/cache']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@emailjs/browser": "^5.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "github-markdown-css": "^5.9.0",
    "marked": "^18.2.1",
    "marked-katex-extension": "^5.1.13",
    "ngx-markdown": "^22.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "executionEnv": {
      "nodeVersion": "24.22.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
